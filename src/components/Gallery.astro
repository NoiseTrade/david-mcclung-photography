---
import { Image, getImage } from 'astro:assets';
import type { GalleryImage } from '../lib/galleryImages';

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;

function formatExifCamera(exif: GalleryImage['exif']) {
  const parts: string[] = [];
  if (exif.camera) parts.push(exif.camera);
  if (exif.lens) parts.push(exif.lens);
  return parts.join(' · ');
}

function formatExifSettings(exif: GalleryImage['exif']) {
  const parts: string[] = [];
  if (exif.focalLength) parts.push(`${Math.round(exif.focalLength)}mm`);
  if (exif.aperture) parts.push(`f/${exif.aperture}`);
  if (exif.shutterSpeed) parts.push(exif.shutterSpeed);
  if (exif.iso) parts.push(`ISO ${exif.iso}`);
  return parts.join(' · ');
}

const galleryItems = await Promise.all(
  images.map(async ({ image, alt, exif }) => {
    const optimized = await getImage({
      src: image,
      widths: [800, 1280, 1920],
      format: 'webp',
      quality: 80,
    });
    return {
      image,
      alt,
      src: optimized.src,
      srcSet: optimized.srcSet.attribute,
      camera: formatExifCamera(exif),
      settings: formatExifSettings(exif),
    };
  })
);
---

<div class="gallery">
  {galleryItems.map(({ image, alt, src, srcSet, camera, settings }, i) => (
    <button
      class="gallery__item"
      data-index={i}
      data-src={src}
      data-srcset={srcSet}
      data-alt={alt}
      data-camera={camera}
      data-settings={settings}
      aria-label={`Open image: ${alt}`}
    >
      <Image
        src={image}
        alt={alt}
        widths={[400, 600, 900]}
        sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 33vw"
        quality={75}
        loading={i < 6 ? 'eager' : 'lazy'}
        decoding="async"
        class="gallery__image"
      />
    </button>
  ))}
</div>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lightbox__close" id="lightbox-close" aria-label="Close">&times;</button>
  <button class="lightbox__arrow lightbox__prev" id="lightbox-prev" aria-label="Previous"></button>
  <button class="lightbox__arrow lightbox__next" id="lightbox-next" aria-label="Next"></button>
  <img src="" srcset="" sizes="90vw" alt="" decoding="async" class="lightbox__image" id="lightbox-image" />
  <div class="lightbox__exif">
    <p class="lightbox__exif-camera" id="lightbox-camera"></p>
    <p class="lightbox__exif-settings" id="lightbox-settings"></p>
  </div>
</div>

<script>
let galleryCleanup: (() => void) | undefined;

function initGallery() {
  if (galleryCleanup) galleryCleanup();

  const lightbox = document.getElementById('lightbox');
  if (!lightbox) return; // guards against running on pages with no gallery

  const controller = new AbortController();
  const { signal } = controller;

  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxCamera = document.getElementById('lightbox-camera');
  const lightboxSettings = document.getElementById('lightbox-settings');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery__item'));

  if (!lightboxImage || !lightboxCamera || !lightboxSettings || !closeBtn || !prevBtn || !nextBtn || items.length === 0) {
    return;
  }

  let current = 0;
  let renderToken = 0;
  const preloaded = new Map<number, HTMLImageElement>();

  function wrapIndex(index: number) {
    return (index + items.length) % items.length;
  }

  function preloadSlide(index: number): HTMLImageElement | undefined {
    const wrapped = wrapIndex(index);
    const existing = preloaded.get(wrapped);
    if (existing) return existing;

    const item = items[wrapped];
    if (!item) return undefined;

    const img = new window.Image();
    img.decoding = 'async';
    img.sizes = '90vw';
    if (item.dataset.srcset) img.srcset = item.dataset.srcset;
    if (item.dataset.src) img.src = item.dataset.src;
    preloaded.set(wrapped, img);
    return img;
  }

  function preloadNeighbors(index: number) {
    preloadSlide(index + 1);
    preloadSlide(index - 1);
    preloadSlide(index + 2);
  }

  function render() {
    const item = items[current];
    if (!item || !lightboxImage || !lightboxCamera || !lightboxSettings) return;

    const token = ++renderToken;
    const fullSrc = item.dataset.src ?? '';
    const fullSrcset = item.dataset.srcset ?? '';

    lightboxImage.alt = item.dataset.alt ?? '';
    lightboxCamera.textContent = item.dataset.camera ?? '';
    lightboxSettings.textContent = item.dataset.settings ?? '';

    const cachedFull = preloaded.get(current);
    if (cachedFull && cachedFull.complete && cachedFull.naturalWidth > 0) {
      lightboxImage.srcset = fullSrcset;
      lightboxImage.src = fullSrc;
      return;
    }

    // Show the already-loaded grid thumbnail immediately so there is zero blank delay
    const thumbImg = item.querySelector('img');
    const thumbSrc = thumbImg?.currentSrc || thumbImg?.src || '';
    if (thumbSrc) {
      lightboxImage.srcset = '';
      lightboxImage.src = thumbSrc;
    } else {
      lightboxImage.srcset = fullSrcset;
      lightboxImage.src = fullSrc;
      return;
    }

    // Load the high-res image in the background and swap seamlessly once ready
    const hiRes = preloadSlide(current);
    if (!hiRes) return;

    const applyHiRes = () => {
      if (token !== renderToken || !lightboxImage) return;
      lightboxImage.srcset = fullSrcset;
      lightboxImage.src = fullSrc;
    };

    if (hiRes.complete && hiRes.naturalWidth > 0) {
      applyHiRes();
    } else {
      hiRes.addEventListener('load', applyHiRes, { once: true, signal });
    }
  }

  function open(index: number) {
    current = wrapIndex(index);
    render();
    preloadNeighbors(current);
    lightbox!.classList.add('is-open');
    lightbox!.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-open');
  }

  function close() {
    renderToken++;
    lightbox!.classList.remove('is-open');
    lightbox!.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('lightbox-open');
    if (lightboxImage) {
      lightboxImage.src = '';
      lightboxImage.srcset = '';
    }
  }

  function show(index: number) {
    current = wrapIndex(index);
    render();
    preloadNeighbors(current);
  }

  items.forEach((item) => {
    const index = Number(item.dataset.index);
    item.addEventListener('pointerenter', () => preloadSlide(index), { signal, passive: true });
    item.addEventListener('touchstart', () => preloadSlide(index), { signal, passive: true });
    item.addEventListener('click', () => open(index), { signal });
  });

  closeBtn.addEventListener('click', close, { signal });
  prevBtn.addEventListener('click', () => show(current - 1), { signal });
  nextBtn.addEventListener('click', () => show(current + 1), { signal });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  }, { signal });

  galleryCleanup = () => {
    close();
    preloaded.clear();
    controller.abort();
  };
}

document.addEventListener('astro:page-load', initGallery);
document.addEventListener('astro:before-swap', () => {
  if (galleryCleanup) galleryCleanup();
});
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .gallery__item {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .gallery__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 200;
  }

  .lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox__image {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .lightbox__arrow {
    position: absolute;
    top: 50%;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .lightbox__arrow::before {
    content: '';
    display: block;
    width: 100%;
    height: 100%;
    border-top: 3px solid #fff;
    border-right: 3px solid #fff;
  }

  .lightbox__prev {
    left: 2rem;
    transform: translateY(-50%) rotate(-135deg);
  }

  .lightbox__next {
    right: 2rem;
    transform: translateY(-50%) rotate(45deg);
  }

  .lightbox__exif {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .lightbox__exif-camera,
  .lightbox__exif-settings {
    margin: 0.25rem 0;
  }
</style>